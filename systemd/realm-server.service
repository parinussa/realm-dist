[Unit]
Description=realm control plane
After=docker.service network-online.target
Wants=docker.service network-online.target

[Service]
Type=simple
User=realm
EnvironmentFile=/etc/realm/env
ExecStart=/usr/bin/java -jar /opt/realm/realm-server.jar
Restart=on-failure
RestartSec=3
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
